# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=

# Gemini API
GEMINI_API_KEY=

# Google OAuth 2.0 (Sign in with Google)
# Credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modern Email Delivery (RECOMMENDED - No Google App Password needed!)
# Free 3,000 emails/month from https://resend.com
RESEND_API_KEY=

# Alternative: SMTP Transporter (If using custom SMTP host like Brevo or Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
